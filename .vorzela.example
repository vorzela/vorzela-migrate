# Vorzela Migration Tool Configuration
# This file is optional. You can also use environment variables or CLI flags.
# Priority: CLI flags > Environment variables > .vorzela file > .env file

# Database Configuration
# =============================================================================
# PostgreSQL (Default):
#   DATABASE_URL=postgres://user:password@localhost:5432/myapp
#
# MySQL/MariaDB (URL style):
#   DATABASE_URL=mysql://user:password@localhost:3306/myapp
#
# MySQL/MariaDB (DSN style):
#   DATABASE_URL=user:password@tcp(localhost:3306)/myapp
#
# Vorzela auto-detects the database type from the DSN.
# =============================================================================

DATABASE_URL=postgres://localhost:5432/myapp

# For MySQL example, uncomment the line below instead:
# DATABASE_URL=mysql://user:password@localhost:3306/myapp

# Migration files path (optional)
# Default: ./migrations
# MIGRATION_PATH=./migrations
# =============================================================================
# COMMAND USAGE EXAMPLES
# =============================================================================

# 1. CREATE NEW MIGRATION (with strong naming conventions!)
#    
#    Pattern: action_details_target
#    
#    Table Operations:
#    $ vm make migration create_users_table
#    $ vm make migration create_posts_table
#    $ vm make migration drop_legacy_data_table
#    
#    Column Operations (STRONG NAMING):
#    $ vm make migration add_email_to_users
#    $ vm make migration add_phone_to_customers
#    $ vm make migration remove_deprecated_field_from_products
#    $ vm make migration rename_user_name_to_full_name
#    
#    Indexes & Constraints:
#    $ vm make migration create_index_on_users_email
#    $ vm make migration add_foreign_key_author_id_to_posts
#    
#    Generated file: migrations/1707129045_create_users_table.sql
#    Includes: Timestamp, CREATE/DROP templates, default columns (id, created_at, updated_at)

# 2. RUN MIGRATIONS (execute pending migrations)
#    $ vm migrate

# 3. ROLLBACK (with flexible options)
#    $ vm rollback              # Rollback last 1 migration batch
#    $ vm rollback --steps=2    # Rollback last 2 migration batches
#    $ vm rollback --steps=all  # Rollback ALL migrations

# 4. FRESH (Rollback ALL + Re-run with confirmation warning)
#    $ ./vm fresh                 # Shows warning, asks for confirmation
#    $ ./vm fresh --force         # Skip confirmation (use with caution!)

# 5. REFRESH (Rollback ALL + Re-run without confirmation)
#    $ ./vm refresh

# 6. STATUS (show which migrations have been executed)
#    $ ./vm status

