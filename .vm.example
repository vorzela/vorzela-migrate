# Vorzela Migration Tool Configuration (.vm)
# Optional: you can also use environment variables or CLI flags.
# Precedence: CLI flags > real env vars > .vm > .env > defaults
#
# Create/validate:
#   vm init        # writes a .vm + migrations directory
#   vm lint        # validates this file

# Database connection (required)
# PostgreSQL (default):
DATABASE_URL=postgres://user:password@localhost:5432/myapp
# MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/myapp
# MySQL DSN style:
# DATABASE_URL=user:password@tcp(localhost:3306)/myapp
# MariaDB: use mysql:// and include "mariadb" in the host or database name.

# Migration files path (default: ./migrations)
# MIGRATION_PATH=./migrations

# Environment defaults: development | production
ENVIRONMENT=development

# Schema drift handling: auto | prompt | reject
DRIFT_HANDLING=prompt

# Optional overrides
# ENHANCED=true
# ONLINE=false
# VERIFY_CHECKSUMS=true
# DETECT_DRIFT=true
# VERBOSE=true
# STRICT=false          # fail on safety warnings (destructive SQL, missing Down)
# SQLC_SUPPORT=false    # add goose Up/Down markers

# Auto-run additive prerequisites before migrate (PostgreSQL only)
AUTO_RUN_EXTENSIONS=true
AUTO_RUN_FUNCTIONS=true
AUTO_RUN_ENUMS=true

# Common commands
#   vm check --json
#   vm make migration users
#   vm migrate --yes
#   vm rollback --dry-run
#   vm status --json
