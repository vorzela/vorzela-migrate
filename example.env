# PostgreSQL Connection String
DATABASE_URL=postgres://username:password@localhost:5432/vorzela_dev
# Or for MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/vorzela_dev

# ============================================
# Environment Configuration
# ============================================
# Options: development, dev, production, prod
# This automatically configures migration strategies
ENVIRONMENT=development

# Development defaults:
#   - Enhanced: true
#   - Online: false
#   - VerifyChecksums: true
#   - DetectDrift: true
#   - Verbose: true

# Production defaults:
#   - Enhanced: true
#   - Online: true (zero-downtime)
#   - VerifyChecksums: true
#   - DetectDrift: true
#   - Verbose: false

# ============================================
# Migration Settings (Optional Overrides)
# ============================================
# Uncomment to override environment defaults

# Enable all enhanced features
# ENHANCED=true

# Use zero-downtime online migration strategies
# ONLINE=true

# Verify migration file checksums
# VERIFY_CHECKSUMS=true

# Detect schema drift (manual DB changes)
# DETECT_DRIFT=true

# Enable verbose logging with timing
# VERBOSE=true

# ============================================
# Schema Drift Handling
# ============================================
# How to handle detected schema drift:
#   - auto: Automatically apply drift fixes
#   - prompt: Ask user before applying (default)
#   - reject: Reject migrations if drift detected
DRIFT_HANDLING=prompt

# ============================================
# Other Settings
# ============================================

# Enable sqlc/goose compatibility markers in migration templates
# Set to true if you use sqlc or other goose-compatible tools
SQLC_SUPPORT=false

# Migration files directory (default: ./migrations)
# MIGRATION_PATH=./migrations
